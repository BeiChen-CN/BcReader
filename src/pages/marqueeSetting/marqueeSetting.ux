<template>
	<div class="page" style="flex-direction: column;">
	  <list class="list">
		  <list-item class="item" @click="toggleShelfMarquee" type="item">
			  <div class="item-content">
				  <text class="itemtext" static>书架</text>
				  <text class="itemtext2" static>内容滚动显示</text>
			  </div>
			  <img src="{{shelfMarqueeEnabled ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" class="switch"/>
		  </list-item>
		  <list-item class="item" @click="toggleBookmarkMarquee" type="item">
			  <div class="item-content">
				  <text class="itemtext" static>书签列表</text>
				  <text class="itemtext2" static>页面标题滚动</text>
			  </div>
			  <img src="{{bookmarkMarqueeEnabled ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" class="switch"/>
		  </list-item>
		  <list-item class="item" @click="toggleBookinfoMarquee" type="item">
			  <div class="item-content">
				  <text class="itemtext" static>书籍详情</text>
				  <text class="itemtext2" static>内容滚动显示</text>
			  </div>
			  <img src="{{bookinfoMarqueeEnabled ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" class="switch"/>
		  </list-item>
		  <list-item class="item" @click="toggleChapterListMarquee" type="item">
			  <div class="item-content">
				  <text class="itemtext" static>章节列表</text>
				  <text class="itemtext2" static>页面标题滚动</text>
			  </div>
			  <img src="{{chapterListMarqueeEnabled ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" class="switch"/>
		  </list-item>
		  <list-item class="item" @click="toggleTextReaderMarquee" type="item">
			  <div class="item-content">
				  <text class="itemtext" static>书籍阅读器</text>
				  <text class="itemtext2" static>页面标题滚动</text>
			  </div>
			  <img src="{{textReaderMarqueeEnabled ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" class="switch"/>
		  </list-item>
		  <list-item class="item" @click="toggleDetailProgressMarquee" type="item">
			  <div class="item-content">
				  <text class="itemtext" static>书籍阅读器</text>
				  <text class="itemtext2" static>底部进度滚动</text>
			  </div>
			  <img src="{{detailProgressMarqueeEnabled ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" class="switch"/>
		  </list-item>
		  <list-item class="item" @click="toggleDetailMarquee" type="item">
			  <div class="item-content">
				  <text class="itemtext" static>文本阅读页</text>
				  <text class="itemtext2" static>页面标题滚动</text>
			  </div>
			  <img src="{{detailMarqueeEnabled ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" class="switch"/>
		  </list-item>
	  </list>
	  
	  <img static src="/common/images/hd.png" style="position: absolute;left: 0px;top: 0px;width: 336px;height: 102px;" />
	  <img static src="/common/images/back.png" @click="back" style="position: absolute;left: 6px;top: 6px;width: 72px;height: 72px;"/>
	  <text style="position: absolute;left: 78px;top: 7px;width: 180px;line-height: 32px;font-weight:bold;font-size:24px;color:rgba(255,255,255,0.6);text-align:center;">
		{{nowTime}}
	  </text>
	  <text static style="position: absolute;left: 78px;top: 35px;width: 180px;line-height: 42px;font-weight:bold;font-size:32px;color:white;text-align:center;">
		  跑马灯设置
	  </text>
	</div>
  </template>
  
  <script>
  import router from '@system.router'
  import storage from '../../utils/storage.js'
  
  const SETTINGS_MAP = [
	{ prop: 'shelfMarqueeEnabled', key: 'EBOOK_SHELF_MARQUEE_ENABLED', def: false },
	{ prop: 'bookmarkMarqueeEnabled', key: 'EBOOK_BOOKMARK_MARQUEE_ENABLED', def: false },
	{ prop: 'bookinfoMarqueeEnabled', key: 'EBOOK_BOOKINFO_MARQUEE_ENABLED', def: true },
	{ prop: 'chapterListMarqueeEnabled', key: 'EBOOK_CHAPTER_LIST_MARQUEE_ENABLED', def: false },
	{ prop: 'textReaderMarqueeEnabled', key: 'EBOOK_TEXT_READER_MARQUEE_ENABLED', def: false },
	{ prop: 'detailMarqueeEnabled', key: 'EBOOK_DETAIL_MARQUEE_ENABLED', def: false },
	{ prop: 'detailProgressMarqueeEnabled', key: 'EBOOK_DETAIL_PROGRESS_MARQUEE_ENABLED', def: false }
  ];
  
  export default {
	private: {
	  shelfMarqueeEnabled: false,
	  bookmarkMarqueeEnabled: false,
	  bookinfoMarqueeEnabled: true,
	  chapterListMarqueeEnabled: false,
	  textReaderMarqueeEnabled: false,
	  detailMarqueeEnabled: false,
	  detailProgressMarqueeEnabled: false,
	  nowTime: "00:00",
	  timer: null,
	  timeFormat: '24h'
	},
  
	onInit() {
	  storage.get({
		  key: 'EBOOK_TIME_FORMAT',
		  success: (data) => {
			  if(data) this.timeFormat = data;
			  this.updateTime();
		  },
		  fail: () => this.updateTime()
	  });
  
	  this.timer = setInterval(() => {
		  this.updateTime();
	  }, 60000);
  
	  SETTINGS_MAP.forEach(item => {
		  storage.get({
			  key: item.key,
			  success: (data) => {
				  this[item.prop] = data ? (data === 'true') : item.def;
			  },
			  fail: () => {
				  this[item.prop] = item.def;
			  }
		  });
	  });
	},
  
	onDestroy() {
	  if (this.timer) {
		clearInterval(this.timer);
		this.timer = null;
	  }
	},
  
	back() {
		router.back();
	},
  
	updateTime() {
	  const date = new Date();
	  let hours = date.getHours();
	  let minutes = date.getMinutes();
	  if (this.timeFormat === '12h') {
		  let ampm = hours >= 12 ? '下午' : '上午';
		  hours = hours % 12;
		  hours = hours ? hours : 12;
		  minutes = minutes < 10 ? '0' + minutes : minutes;
		  this.nowTime = `${ampm} ${hours}:${minutes}`;
	  } else {
		  hours = hours < 10 ? '0' + hours : hours;
		  minutes = minutes < 10 ? '0' + minutes : minutes;
		  this.nowTime = `${hours}:${minutes}`;
	  }
	},
  
	toggleSetting(prop, key) {
	  this[prop] = !this[prop];
	  storage.set({
		  key: key,
		  value: this[prop].toString()
	  });
	},
  
	toggleShelfMarquee() { this.toggleSetting('shelfMarqueeEnabled', 'EBOOK_SHELF_MARQUEE_ENABLED'); },
	toggleBookmarkMarquee() { this.toggleSetting('bookmarkMarqueeEnabled', 'EBOOK_BOOKMARK_MARQUEE_ENABLED'); },
	toggleBookinfoMarquee() { this.toggleSetting('bookinfoMarqueeEnabled', 'EBOOK_BOOKINFO_MARQUEE_ENABLED'); },
	toggleChapterListMarquee() { this.toggleSetting('chapterListMarqueeEnabled', 'EBOOK_CHAPTER_LIST_MARQUEE_ENABLED'); },
	toggleTextReaderMarquee() { this.toggleSetting('textReaderMarqueeEnabled', 'EBOOK_TEXT_READER_MARQUEE_ENABLED'); },
	toggleDetailMarquee() { this.toggleSetting('detailMarqueeEnabled', 'EBOOK_DETAIL_MARQUEE_ENABLED'); },
	toggleDetailProgressMarquee() { this.toggleSetting('detailProgressMarqueeEnabled', 'EBOOK_DETAIL_PROGRESS_MARQUEE_ENABLED'); }
  }
  </script>
  
  <style>
	@import '../../common/style.css';
  </style>
  