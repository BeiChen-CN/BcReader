<template>
	<scroll class="page" scroll-y="true">
		<div class="content-wrapper">
			<text class="tip-title">{{title}}</text>
			<text class="tip-content">{{content}}</text>
			<img static src="/common/images/conform2.png" class="confirm-button" @click="confirm"/>
		</div>
	</scroll>
</template>

<script>
import router from '@system.router'
import storage from '../../utils/storage.js'

export default {
    protected: {
        title: '提示',
        content: '这是一个提示信息。',
        isFirstLaunch: false
    },
	confirm() {
        if (this.isFirstLaunch) {
            storage.set({
                key: 'EBOOK_FIRST_LAUNCH_TIP_SHOWN',
                value: 'true',
                complete: function() {
                    router.back();
                }
            });
        } else {
		    router.back();
        }
	}
}
</script>

<style>
@import '../../common/style.css';

.page {
	width: 100%;
	height: 100%;
	flex-direction: column;
}

.content-wrapper {
	width: 100%;
	flex-direction: column;
	align-items: center;
	padding: 80px 40px; 
}

.tip-title {
	font-size: 36px;
	font-weight: bold;
	color: #FFFFFF;
	text-align: center;
	margin-bottom: 40px;
}

.tip-content {
	width: 100%;
	font-size: 28px;
	color: rgba(255, 255, 255, 0.8);
	text-align: left;
	line-height: 38px;
	margin-bottom: 60px;
}

.confirm-button {
	width: 102px;
	height: 72px;
	margin-bottom: 20px; 
}
</style>
