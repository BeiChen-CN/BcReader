<template>
	<div class="page">
		<list class="list" style="padding: 86px 6px 6px 6px;">
			<list-item if="{{hasCover}}" type="cover" style="height: 255px; align-items: center; justify-content: center; margin-bottom: 12px;">
				<img src="{{coverPath}}" style="width: 160px;height: 213px;object-fit: cover;border-radius: 12px;" />
			</list-item>

			<list-item class="item item3" type="info">
				<text class="item-title" static>文件名</text>
				<marquee if="{{bookinfoMarqueeEnabled}}" class="item-value" scrollamount="50" text-offset="25">{{fileName}}</marquee>
				<text else class="item-value">{{fileName}}</text>
			</list-item>
			<list-item class="item item3" type="info" if="{{author}}">
				<text class="item-title" static>作者</text>
				<marquee if="{{bookinfoMarqueeEnabled}}" class="item-value" scrollamount="50" text-offset="25">{{author}}</marquee>
				<text else class="item-value">{{author}}</text>
			</list-item>
			<list-item class="item item3" type="info" style="height: 280px; flex-direction: column;">
				<text class="item-title" static>占用空间</text>
				<text class="item-value" style="width: auto;">{{totalStorage}}</text>
				<div static style="width: 100%; height: 1px; background-color: rgba(255,255,255,0.2); margin: 8px 0px;"></div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%;">
					<text class="item-title" style="font-size: 24px;" static>章节占用</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{chapterStorage}}</text>
				</div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%;">
					<text class="item-title" style="font-size: 24px;" static>封面占用</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{coverStorage}}</text>
				</div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%;">
					<text class="item-title" style="font-size: 24px;" static>索引占用</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{indexStorage}}</text>
				</div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%;">
					<text class="item-title" style="font-size: 24px;" static>书签索引占用</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{bookmarkIndexStorage}}</text>
				</div>
			</list-item>
			<list-item class="item item3" type="info">
				<text class="item-title" static>同步进度</text>
				<text class="item-value">{{syncProgress}}</text>
			</list-item>
			<list-item class="item item3" type="info">
				<text class="item-title" static>总字数</text>
				<text class="item-value">{{wordCount}}</text>
			</list-item>
			<list-item class="item item3" type="info" if="{{bookStatus}}">
				<text class="item-title" static>状态</text>
				<text class="item-value">{{bookStatus}}</text>
			</list-item>
			<list-item class="item item3" type="info" if="{{category}}">
				<text class="item-title" static>分类</text>
				<text class="item-value">{{category}}</text>
			</list-item>
			<list-item class="item item3" type="info" if="{{localCategory}}">
				<text class="item-title" static>本地分类</text>
				<text class="item-value">{{localCategory}}</text>
			</list-item>
			<list-item class="item item3" type="summary" if="{{summary}}" @click="showSummary">
				<text class="item-title" static>书籍简介</text>
				<text class="item-value" style="color: rgba(255,255,255,0.8);" static>点击查看 →</text>
			</list-item>
		</list>

		<img static src="/common/images/hd.png" style="position: absolute;left: 0px;top: 0px;width: 336px;height: 102px;" />
		<img static src="/common/images/back.png" @click="back" style="position: absolute;left: 6px;top: 6px;width: 72px;height: 72px;" />
		<text style="position: absolute;left: 78px;top: 7px;width: 180px;line-height: 32px;font-weight:bold;font-size:24px;color:rgba(255,255,255,0.6);text-align:center;">
			{{nowTime}}
		</text>
		<text static style="position: absolute;left: 78px;top: 35px;width: 180px;line-height: 42px;font-weight:bold;font-size:32px;color:white;text-align:center;">
			书籍详情
		</text>
	</div>
</template>

<script>
import router from '@system.router'
import file from '@system.file'
import runAsyncFunc from '../../utils/runAsyncFunc.js'
import storage from '../../utils/storage.js'
import chapterManager from '../../utils/chapterManager.js'
import bookStorage from '../../utils/bookStorage.js'

export default {
	private: {
		fileName: '加载中...',
		totalStorage: '加载中...',
		chapterStorage: '加载中...',
		coverStorage: '加载中...',
		indexStorage: '加载中...',
		bookmarkIndexStorage: '加载中...',
		wordCount: '加载中...',
		nowTime: "00:00",
		timer: null,
		hasCover: false,
		coverPath: '',
		author: '',
		summary: '',
		bookStatus: '',
		category: '',
		localCategory: '',
		syncProgress: '计算中...',
		timeFormat: '24h',
		bookinfoMarqueeEnabled: true
	},
	protected: {
		name: '' // 移除了完全未被使用的 cPath
	},
	
	onInit() {
		// 移除了 onInit 中的 global.runGC()。页面初始化时进行垃圾回收会严重阻塞渲染，导致打开详情页卡顿
		this.loadTimeFormat();
		this.loadFileInfo();
	},
	
	onShow() {
		storage.get({
			key: 'EBOOK_BOOKINFO_MARQUEE_ENABLED',
			success: (data) => {
				this.bookinfoMarqueeEnabled = data === 'true';
			},
			fail: () => {
				this.bookinfoMarqueeEnabled = true;
			}
		});
	},
	
	onDestroy() {
		if (this.timer) {
			clearInterval(this.timer);
			this.timer = null;
		}
		global.runGC(); // 退出页面时回收内存是合理的
	},

	loadTimeFormat() {
		storage.get({
			key: 'EBOOK_TIME_FORMAT',
			success: (data) => {
				if (data) this.timeFormat = data;
				this.updateTime();
			},
			fail: () => {
				this.updateTime();
			}
		});
		
		// 性能优化：时间显示只精确到了分钟 (00:00)，原代码每 1000ms(1秒) 刷新一次是极大的性能和电量浪费
		// 现已改为 60000ms(1分钟) 刷新一次
		this.timer = setInterval(() => {
			this.updateTime();
		}, 60000);
	},

	updateTime() {
		const date = new Date();
		let hours = date.getHours();
		let minutes = date.getMinutes();
		if (this.timeFormat === '12h') {
			let ampm = hours >= 12 ? '下午' : '上午';
			hours = hours % 12 || 12;
			minutes = minutes < 10 ? '0' + minutes : minutes;
			this.nowTime = `${ampm} ${hours}:${minutes}`;
		} else {
			hours = hours < 10 ? '0' + hours : hours;
			minutes = minutes < 10 ? '0' + minutes : minutes;
			this.nowTime = `${hours}:${minutes}`;
		}
	},

	back() {
		router.back();
	},

	showSummary() {
		router.push({
			uri: 'pages/textReader',
			params: {
				pageTitle: '简介',
				pageContent: this.summary
			}
		});
	},

	async loadFileInfo() {
		const bookDirUri = `internal://files/books/${this.name}/`;
		const bookContentDirUri = `${bookDirUri}content/`;
		const bookInfoUri = `${bookDirUri}book_info.json`;
		const indexesUri = `${bookDirUri}indexes/`;
		const lindexUri = `${bookDirUri}lindex.txt`;
		let coverUri = '';

		file.readText({
			uri: bookInfoUri,
			success: async (data) => {
				try {
					const info = JSON.parse(data.text);
					this.fileName = info.name || this.name;
					this.wordCount = info.wordCount ? `${info.wordCount} 字` : '未知';
					this.hasCover = info.hasCover || false;
					if (this.hasCover && info.coverFileName) {
						this.coverPath = bookDirUri + info.coverFileName;
						coverUri = this.coverPath;
					}
					this.author = info.author || '';
					this.summary = info.summary || '';
					this.bookStatus = info.bookStatus || '';
					this.category = info.category || '';
					this.localCategory = info.localCategory || '';

					await this.calculateSyncProgress();
					await this.calculateStorage(bookContentDirUri, bookInfoUri, indexesUri, lindexUri, coverUri);
				} catch (e) {
					this.handleLoadFail();
				}
			},
			fail: () => {
				this.handleLoadFail();
			}
		});
	},

	// 提取出冗余的失败处理逻辑
	handleLoadFail() {
		this.fileName = this.name;
		this.wordCount = '加载失败';
		this.syncProgress = '未知';
		this.resetStorageStatus('计算失败');
	},

	resetStorageStatus(status) {
		this.totalStorage = status;
		this.chapterStorage = status;
		this.coverStorage = status;
		this.indexStorage = status;
		this.bookmarkIndexStorage = status;
	},

	async calculateStorage(bookContentDirUri, bookInfoUri, indexesUri, lindexUri, coverUri) {
		this.resetStorageStatus('计算中...');
		try {
			const [chapterSize, coverSize, indexSize, bookmarkSize] = await Promise.all([
				this.getDirSize(bookContentDirUri),
				coverUri ? this.getFileSize(coverUri) : 0,
				this.getIndexTotalSize(bookInfoUri, lindexUri, indexesUri),
				this.getBookmarkSize()
			]);

			this.chapterStorage = this.formatFileSize(chapterSize);
			this.coverStorage = this.formatFileSize(coverSize);
			this.indexStorage = this.formatFileSize(indexSize);
			this.bookmarkIndexStorage = this.formatFileSize(bookmarkSize);
			this.totalStorage = this.formatFileSize(chapterSize + coverSize + indexSize + bookmarkSize);
		} catch (e) {
			this.resetStorageStatus('计算失败');
		}
	},

	async getFileSize(uri) {
		try {
			const res = await runAsyncFunc(file.get, { uri });
			return res ? res.length : 0;
		} catch (e) {
			return 0;
		}
	},

	async getDirSize(uri) {
		try {
			const res = await runAsyncFunc(file.list, { uri });
			if (!res || !res.fileList) return 0;
			return res.fileList.reduce((acc, f) => acc + (f.type === 'file' ? f.length : 0), 0);
		} catch (e) {
			return 0;
		}
	},

	async getIndexTotalSize(bookInfoUri, lindexUri, indexesUri) {
		try {
			const [infoSize, lindexSize, indexesDirSize] = await Promise.all([
				this.getFileSize(bookInfoUri),
				this.getFileSize(lindexUri),
				this.getDirSize(indexesUri)
			]);
			return infoSize + lindexSize + indexesDirSize;
		} catch (e) {
			return 0;
		}
	},

	async getBookmarkSize() {
		try {
			const bookshelf = await bookStorage.load();
			if (!bookshelf || !bookshelf.books) return 0;
			const book = bookshelf.books.find(b => b.dirName === this.name);
			if (book && book.progress && book.progress.bookmarks) {
				return JSON.stringify(book.progress.bookmarks).length;
			}
			return 0;
		} catch (e) {
			return 0;
		}
	},

	async calculateSyncProgress() {
		const version = await chapterManager.checkVersion(this.name);
		if (version === 'none') {
			this.syncProgress = '无章节信息';
			return;
		}
		try {
			const bookIndex = await chapterManager.loadBookIndex(this.name);
			const { totalChapters, syncedChapters } = bookIndex;
			if (typeof totalChapters !== 'number' || totalChapters <= 0) {
				this.syncProgress = '无需同步';
				return;
			}
			const progress = Math.floor((syncedChapters / totalChapters) * 100);
			this.syncProgress = `${progress}% (${syncedChapters}/${totalChapters}章)`;
		} catch (e) {
			this.syncProgress = '计算失败';
		}
	},

	formatFileSize(bytes) {
		if (bytes === 0) return '0 Bytes';
		const k = 1024;
		const sizes = ['Bytes', 'KB', 'MB', 'GB'];
		const i = Math.floor(Math.log(bytes) / Math.log(k));
		return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
	}
}
</script>

<style>
  @import '../../common/style.css';
.item-title {
	font-size: 28px;
	line-height: 37px;
	font-weight: bold;
	color: rgba(255,255,255,0.6);
}
.item-value {
	font-size: 32px;
	line-height: 40px;
	width: 100%;
	font-weight: bold;
	color: white;
	lines: 1;
}
.item3 {
	flex-direction: column;
	align-items: flex-start;
}
</style>
