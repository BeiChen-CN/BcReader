<template>
	<div class="page">
		<text class="tip-title">使用提醒</text>
		<text class="tip-content">由于无缝加载的逻辑问题，换页时可能会有部分滚动错位，阅读请确认行和字的位置。</text>
		<img src="/common/images/conform2.png" class="confirm-button" @click="confirm"/>
	</div>
</template>

<script>
import router from '@system.router'
import storage from '../../common/storage.js'

export default {
	confirm() {
		storage.set({
			key: 'EBOOK_FIRST_LAUNCH_TIP_SHOWN',
			value: 'true',
			complete: function() {
				router.back();
			}
		});
	}
}
</script>

