<template>
	<div class="page" style="flex-direction: column;">
	  <div class="item">
		  <text style="font-size: 36px;font-weight:bold;color: white;width: 100%;text-align: center;">
			  {{inputPercent}}%
		  </text>
		  <text style="font-size: 24px;font-weight:bold;color: rgba(255, 255, 255, 0.6);width: 100%;text-align: center;">
			  当前章节进度
		  </text>
	  </div>
	  <div class="row" style="top:228px">
		  <img static src="/common/images/num_pad/7.png" @click="onClick('7')"/>
		  <img static src="/common/images/num_pad/8.png" @click="onClick('8')"/>
		  <img static src="/common/images/num_pad/9.png" @click="onClick('9')"/>
	  </div>
	  <div class="row" style="top:298px">
		  <img static src="/common/images/num_pad/4.png" @click="onClick('4')"/>
		  <img static src="/common/images/num_pad/5.png" @click="onClick('5')"/>
		  <img static src="/common/images/num_pad/6.png" @click="onClick('6')"/>
	  </div>
	  <div class="row" style="top:368px">
		  <img static src="/common/images/num_pad/1.png" @click="onClick('1')"/>
		  <img static src="/common/images/num_pad/2.png" @click="onClick('2')"/>
		  <img static src="/common/images/num_pad/3.png" @click="onClick('3')"/>
	  </div>
	  <div class="row" style="top:438px">
		  <img static src="/common/images/num_pad/0.png" @click="onClick('0')"/>
		  <img static src="/common/images/num_pad/del.png" @click="onClick('del')"/>
	  </div>
  
	  <img static src="/common/images/back.png" @click="back" style="position: absolute;left: 38px;top: 24px;width: 82px;height: 82px;"/>
	  <img static src="/common/images/conform.png" @click="onClick('conform')" style="position: absolute;left: 322px;top: 24px;width: 82px;height: 82px;"/>
	  <text style="position: absolute;left: 130px;top: 16px;width: 172px;line-height: 32px;font-weight:bold;font-size:24px;color:rgba(255,255,255,0.6);text-align:center;">
		{{nowTime}}
	  </text>
	  <text static style="position: absolute;left: 130px;top: 46px;width: 172px;line-height: 42px;font-weight:bold;font-size:32px;color:white;text-align:center;">
		  跳转百分比
	  </text>
	</div>
</template>
  
<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import file from '@system.file'
  import bookStorage from '../../utils/bookStorage.js'
  import chapterManager from '../../utils/chapterManager.js'
  import runAsyncFunc from '../../utils/runAsyncFunc.js'
  
  export default {
	private: {
	  inputPercent: '0',
	  nowTime: "00:00",
	  timer: null,
	  currentChapterIndex: null
	},
	protected: {
	  name: ''
	},
    
	onInit() {
	  this.updateTime();
	  this.timer = setInterval(() => {
		this.updateTime();
	  }, 60000); 
	  this.loadData();
	},
    
	onDestroy() {
	  if (this.timer) {
		clearInterval(this.timer);
		this.timer = null;
	  }
	},
    
	updateTime() {
	  const date = new Date();
	  let hours = date.getHours();
	  let minutes = date.getMinutes();
  
	  hours = hours < 10 ? '0' + hours : hours;
	  minutes = minutes < 10 ? '0' + minutes : minutes;
  
	  this.nowTime = `${hours}:${minutes}`;
	},
    
	async loadData() {
	  let progress = await bookStorage.get(this.name);
	  if (progress.chapterIndex !== null && progress.chapterIndex !== undefined) {
		this.currentChapterIndex = progress.chapterIndex;
		
		if (globalThis.readerChapterIndex === this.currentChapterIndex && globalThis.readerChapterAllSize > 0 && globalThis.readerChapterProgressPercent !== undefined && globalThis.readerChapterProgressPercent !== null) {
		  const percent = Math.round(globalThis.readerChapterProgressPercent);
		  this.inputPercent = Math.min(100, Math.max(0, percent)).toString();
		} else if (progress.chapterProgressPercent !== undefined && progress.chapterProgressPercent !== null) {
		  const percent = Math.round(progress.chapterProgressPercent);
		  this.inputPercent = percent.toString();
		} else {
		  this.inputPercent = '0';
		}
	  } else {
		this.currentChapterIndex = null;
		this.inputPercent = '0';
	  }
	},
    
	async onClick(num) {
	  if (num === 'del') {
		if (this.inputPercent.length > 1) {
		  this.inputPercent = this.inputPercent.slice(0, -1);
		} else {
		  this.inputPercent = '0';
		}
		return;
	  }
  
	  if (num === 'conform') {
		if (this.currentChapterIndex === null || this.currentChapterIndex === undefined) {
		  prompt.showToast({ message: '无法跳转，章节信息错误', duration: 2000 });
		  return;
		}

		let targetPercent = parseFloat(this.inputPercent);
		if (isNaN(targetPercent) || targetPercent < 0) {
		  targetPercent = 0;
		}
		if (targetPercent > 100) {
		  targetPercent = 100;
		}

		try {
		  const chapter = await chapterManager.getChapterByIndex(this.name, this.currentChapterIndex);
		  if (!chapter) {
			prompt.showToast({ message: '章节不存在', duration: 2000 });
			return;
		  }

		  let allSize = 0;
		  if (globalThis.readerChapterIndex === this.currentChapterIndex && globalThis.readerChapterAllSize > 0) {
			allSize = globalThis.readerChapterAllSize;
		  } else {
			const chapterPath = `internal://files/books/${this.name}/content/${chapter.index}.txt`;
			const fileInfo = await runAsyncFunc(file.get, { uri: chapterPath });
			allSize = fileInfo.length;
		  }
		  
		  if (allSize <= 0) {
			prompt.showToast({ message: '章节内容为空', duration: 2000 });
			return;
		  }

		  const targetOffset = Math.floor((targetPercent / 100) * allSize);
		  const segmentSize = globalThis.readerTxtSizePage ? globalThis.readerTxtSizePage * 2 : 800 * 2;
		  const segmentStart = Math.floor(targetOffset / segmentSize) * segmentSize;
		  const maxSegmentStart = Math.max(0, allSize - segmentSize);
		  const offsetInChapter = Math.max(0, Math.min(segmentStart, maxSegmentStart));
		  
		  let progress = await bookStorage.get(this.name);
		  progress.chapterIndex = this.currentChapterIndex;
		  progress.offsetInChapter = offsetInChapter;
		  progress.scrollOffset = 0;
		  await bookStorage.set(this.name, progress);
		  
		  prompt.showToast({ message: '设置成功', duration: 1000 });
		  globalThis.justJumpedFromPercent = true;
		  globalThis.justJumpedChapterIndex = this.currentChapterIndex;
		  globalThis.justJumpedOffsetInChapter = offsetInChapter;
		  globalThis.justJumpedTargetPercent = targetPercent;
		  router.back();
		} catch (e) {
		  prompt.showToast({ message: '设置失败: ' + (e.message || '未知错误'), duration: 2000 });
		}
		return;
	  }
  
	  const currentVal = this.inputPercent === '0' ? '' : this.inputPercent;
	  const newValStr = currentVal + num;
	  const newVal = parseFloat(newValStr);
  
	  if (newVal > 100) {
		prompt.showToast({ message: '最大百分比为 100%', duration: 1000 });
	  } else {
		this.inputPercent = newValStr;
	  }
	},
    
	back() {
	  router.back();
	}
  }
</script>
  
<style>
  .page {
	  width: 432px;
	  height: 514px;
	  background-color: #000000;
  }
  
  .item {
	  position: absolute;
	  left: 27px;
	  top: 114px;
	  width: 378px;
	  height: 102px;
	  border-radius: 36px;
	  flex-direction: column;
	  border: 3px solid #262626;
	  justify-content: center;
  }

  .row {
	  position:absolute;
	  left: 32px;
	  width:358px;
	  height:77px;
	  padding:0px 6px;
	  justify-content: space-between;
  }
</style>
