<template>
	<div class="page" style="flex-direction: column;">
	  <list class="list">
		<list-item class="page-title-item" type="title">
			<text static class="page-title">
				翻页方式
			</text>
		</list-item>

		  <list-item class="item {{onSelect==2?'item2':''}}" @click="select('2')" type="item">
			<text class="itemtext" static>上下滑动</text>
			  <img src="/common/images/check.png" class="check" if="{{onSelect==2}}"/>
		  </list-item>

		  <list-item class="item {{onSelect==3?'item2':''}}" @click="select('3')" type="item">
			<text class="itemtext" static>点击翻页</text>
			<img src="/common/images/check.png" class="check" if="{{onSelect==3}}"/>
		  </list-item>
	  </list>

	  <img static src="/common/images/set.png" @click="back()" class="header-more"/>
	</div>
</template>

<script>
  import router from '@system.router'
  import storage from '../../utils/storage.js'

  export default {
	private: {
		onSelect: 3
	},
	
	onShow() {
	  storage.get({
		  key: 'EBOOK_SWIPE',
		  success: (data) => {
			if (data === "off") {
				this.onSelect = 3;
			} else if (data === "column") {
				this.onSelect = 2;
			} else if (data === "row") {
				this.onSelect = 1;
			}
		  }
	  })
	},

	select(fun) {
	  if (fun === '2' && this.onSelect !== 2) {
		this.onSelect = 2;
		storage.set({ key: 'EBOOK_SWIPE', value: 'column' });
	  } else if (fun === '1' && this.onSelect !== 1) {
		this.onSelect = 1;
		storage.set({ key: 'EBOOK_SWIPE', value: 'row' });
	  } else if (fun === '3' && this.onSelect !== 3) {
		this.onSelect = 3;
		storage.set({ key: 'EBOOK_SWIPE', value: 'off' });
	  }
	},

	back() {
		router.back();
	}
  }
</script>

<style>
  @import '../../common/style.css';
</style>
