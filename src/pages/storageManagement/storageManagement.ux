<template>
	<div class="page">
		<list class="list" style="padding: 116px 12px;">
			<list-item class="item storage-item" type="info" style="height: 310px; flex-direction: column;">
				<text class="item-title" style="text-align: left; margin-bottom: 12px;" static>手环存储空间</text>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 8px;">
					<text class="item-title" style="font-size: 24px;" static>总空间</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{totalStorage}}</text>
				</div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 8px;">
					<text class="item-title" style="font-size: 24px;" static>已用空间</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{usedStorage}}</text>
				</div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 8px;">
					<text class="item-title" style="font-size: 24px;" static>预留空间</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{reservedStorage}}</text>
				</div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%; margin-bottom: 12px;">
					<text class="item-title" style="font-size: 24px;" static>实际可用</text>
					<text class="item-value" style="font-size: 24px; width: auto; color: {{actualAvailableColor}};">{{actualAvailableStorage}}</text>
				</div>
				<progress class="storage-progress" percent="{{storagePercent}}" type="horizontal" style="color: #888;"></progress>
				<text class="progress-text" style="text-align: center; margin-top: 4px;">{{usedStorage}} / {{usableStorage}}</text>
			</list-item>
			<list-item class="item" type="info" style="height: 280px; flex-direction: column;">
				<text class="item-title" style="text-align: left;" static>除书籍以外的总占用</text>
				<text class="item-value" style="width: auto;">{{totalExclBooks}}</text>
				<div static style="width: 100%; height: 1px; background-color: rgba(255,255,255,0.2); margin: 8px 0px;"></div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%;">
					<text class="item-title" style="font-size: 24px;" static>书籍索引占用</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{bookIndexStorage}}</text>
				</div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%;">
					<text class="item-title" style="font-size: 24px;" static>阅读进度占用</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{readProgressStorage}}</text>
				</div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%;">
					<text class="item-title" style="font-size: 24px;" static>阅读时长占用</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{readingTimeStorage}}</text>
				</div>
				<div style="display: flex; flex-direction: row; justify-content: space-between; width: 100%;">
					<text class="item-title" style="font-size: 24px;" static>设置数据占用</text>
					<text class="item-value" style="font-size: 24px; width: auto;">{{settingsStorage}}</text>
				</div>
			</list-item>

			<list-item class="item" type="item" @click="clearReadingTime">
				<div class="item-content">
					<text class="itemtext" static>清空阅读时长</text>
					<text class="itemtext2" static>清空所有时长数据</text>
				</div>
				<img src="/common/images/enter.png" style="width:40px;height: 40px;" static />
			</list-item>
			<list-item class="item" type="item" @click="clearBooks">
				<div class="item-content">
					<text class="itemtext" static>清空数据</text>
					<text class="itemtext2" static>清空全部数据</text>
				</div>
				<img src="/common/images/enter.png" style="width:40px;height: 40px;" static />
			</list-item>
		</list>

		<img static src="/common/images/hd.png" style="position: absolute;left: 0px;top: 0px;width: 432px;height: 102px;" />
		<img static src="/common/images/back.png" @click="back" style="position: absolute;left: 38px;top: 24px;width: 82px;height: 82px;" />
		<text style="position: absolute;left: 130px;top: 16px;width: 172px;line-height: 32px;font-weight:bold;font-size:24px;color:rgba(255,255,255,0.6);text-align:center;">
			{{nowTime}}
		</text>
		<text static style="position: absolute;left: 130px;top: 46px;width: 172px;line-height: 42px;font-weight:bold;font-size:32px;color:white;text-align:center;">
			存储管理
		</text>
	</div>
</template>

<script>
import router from '@system.router'
import file from '@system.file'
import device from '@system.device'
import storage from '../../utils/storage.js'
import runAsyncFunc from '../../utils/runAsyncFunc.js'
import bookStorage from '../../utils/bookStorage.js'
import readingTimeStorage from '../../utils/readingTimeStorage.js'
import { calculateStorageInfo, isStorageLow } from '../../utils/storageUtils.js'

export default {
	private: {
		nowTime: "00:00",
		timer: null,
		totalStorage: '加载中...',
		usedStorage: '加载中...',
		reservedStorage: '加载中...',
		actualAvailableStorage: '加载中...',
		actualAvailableColor: 'white',
		storagePercent: 0,
		usableStorage: '计算中...',
		totalExclBooks: '加载中...',
		bookIndexStorage: '加载中...',
		readProgressStorage: '加载中...',
		readingTimeStorage: '加载中...',
		settingsStorage: '加载中...',
		timeFormat: '24h',
		deviceProduct: null
	},
	onInit() {
		this.loadSettings();
		this.timer = setInterval(() => { this.updateTime(); }, 1000);
		this.refreshData();
	},
	onShow() {
		this.loadSettings();
		this.refreshData();
	},
	onDestroy() {
		if (this.timer) {
			clearInterval(this.timer);
			this.timer = null;
		}
		global.runGC();
	},
	loadSettings() {
		storage.get({
			key: 'EBOOK_TIME_FORMAT',
			success: (data) => {
				if (data) this.timeFormat = data;
				this.updateTime();
			}
		});
	},
	refreshData() {
		this.loadDeviceStorage();
		this.calculateAppDataUsage();
	},
	updateTime() {
		const date = new Date();
		let hours = date.getHours();
		let minutes = date.getMinutes();
		if (this.timeFormat === '12h') {
			let ampm = hours >= 12 ? '下午' : '上午';
			hours = hours % 12;
			hours = hours ? hours : 12;
			minutes = minutes < 10 ? '0' + minutes : minutes;
			this.nowTime = `${ampm} ${hours}:${minutes}`;
		} else {
			hours = hours < 10 ? '0' + hours : hours;
			minutes = minutes < 10 ? '0' + minutes : minutes;
			this.nowTime = `${hours}:${minutes}`;
		}
	},
	loadDeviceStorage() {
		device.getInfo({
			success: (ret) => {
				this.deviceProduct = ret.product;
				device.getTotalStorage({
					success: (data) => {
						const total = data.totalStorage || 0;
						this.totalStorage = this.formatFileSize(total);
						device.getAvailableStorage({
							success: (availData) => {
								const avail = availData.availableStorage || 0;
								const info = calculateStorageInfo(total, avail, this.deviceProduct);

								this.usedStorage = this.formatFileSize(info.usedStorage);
								this.reservedStorage = this.formatFileSize(info.reservedStorage);
								this.actualAvailableStorage = this.formatFileSize(info.actualAvailable);
								this.actualAvailableColor = isStorageLow(info.actualAvailable) ? '#f14444' : 'white';

								const usable = total - info.reservedStorage;
								this.usableStorage = this.formatFileSize(usable);
								this.storagePercent = usable > 0 ? Math.round((info.usedStorage / usable) * 100) : 0;
							},
							fail: () => this.handleStorageError()
						});
					},
					fail: () => this.handleStorageError()
				});
			},
			fail: () => {
				this.deviceProduct = null;
				this.handleStorageError();
			}
		});
	},
	handleStorageError() {
		this.totalStorage = '获取失败';
		this.usedStorage = '获取失败';
		this.reservedStorage = '获取失败';
		this.actualAvailableStorage = '获取失败';
		this.storagePercent = 0;
	},
	async calculateAppDataUsage() {
		this.totalExclBooks = '计算中...';
		try {
			let progressBytes = 0;
			try {
				const bookshelf = await bookStorage.load();
				if (bookshelf.books) {
					bookshelf.books.forEach(b => {
						if (b.progress) {
							const copy = Object.assign({}, b.progress);
							delete copy.bookmarks;
							progressBytes += JSON.stringify(copy).length;
						}
					});
				}
			} catch (e) { }
			this.readProgressStorage = this.formatFileSize(progressBytes);

			let readingTimeBytes = 0;
			try {
				const times = await readingTimeStorage.getAllBooksReadingTime();
				readingTimeBytes = JSON.stringify(times).length;
			} catch (e) { }
			this.readingTimeStorage = this.formatFileSize(readingTimeBytes);

			let bookIndexBytes = 0;
			let settingsBytes = 0;

			const getFileSize = async (uri) => {
				try {
					const r = await runAsyncFunc(file.get, { uri });
					return r.length || 0;
				} catch (e) { return 0; }
			};

			bookIndexBytes = await getFileSize('internal://files/books/bookshelf.json');
			this.bookIndexStorage = this.formatFileSize(bookIndexBytes);

			settingsBytes = await getFileSize('internal://files/books/storage-api/savedFile');
			this.settingsStorage = this.formatFileSize(settingsBytes);

			const totalExcl = bookIndexBytes + progressBytes + readingTimeBytes + settingsBytes;
			this.totalExclBooks = this.formatFileSize(totalExcl);

		} catch (e) {
			this.totalExclBooks = '计算错误';
		}
	},
	formatFileSize(bytes) {
		if (!bytes || bytes === 0) return '0 Bytes';
		const k = 1024;
		const sizes = ['Bytes', 'KB', 'MB', 'GB'];
		const i = Math.floor(Math.log(bytes) / Math.log(k));
		return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
	},
	clearReadingTime() {
		router.push({
			uri: '/pages/confirm',
			params: {
				action: 'clearReadingTime',
				title: '清空时长',
				confirmText: '确认清空时长数据？',
				subText: '此操作不可逆'
			}
		});
	},
	clearBooks() {
		router.push({
			uri: '/pages/help',
			params: {
				title: '清空数据',
				content: '为防止卡死，请手动将小程序卸载后重新安装。'
			}
		});
	},
	back() {
		router.back();
	}
}
</script>

<style>
.page {
	width: 432px;
	height: 514px;
	background-color: #000000;
}
.list {
	width: 432px;
	height: 514px;
	position: absolute;
	top: 0px;
	left: 0px;
}
.item {
	width: 100%;
	height: 112px;
	padding: 14px 20px;
	margin-bottom: 8px;
	background-color: #262626;
	border-radius: 36px;
	align-items: center;
	justify-content: space-between;
}
.itemtext {
	font-size: 32px;
	line-height: 40px;
	width: 100%;
	font-weight: bold;
	color: white;
	text-overflow: ellipsis;
	lines: 1;
}
.itemtext2 {
	font-size: 28px;
	line-height: 37px;
	font-weight: bold;
	color: rgba(255, 255, 255, 0.6);
	text-overflow: ellipsis;
	lines: 1;
}
.item-value {
	font-size: 32px;
	line-height: 40px;
	width: 100%;
	font-weight: bold;
	color: white;
	lines: 1;
}
.item-content {
	height: 100%;
	flex: 1;
	flex-direction: column;
	justify-content: space-between;
}
.item-title {
	font-size: 28px;
	line-height: 37px;
	font-weight: bold;
	color: rgba(255, 255, 255, 0.6);
}
.storage-item {
	background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%);
	border: 1px solid rgba(255, 255, 255, 0.1);
}
.storage-progress {
	width: 100%;
	height: 8px;
	margin-top: 8px;
}
.progress-text {
	font-size: 22px;
	line-height: 30px;
	color: rgba(255, 255, 255, 0.5);
}
</style>
