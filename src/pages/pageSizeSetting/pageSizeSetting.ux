<import name="number" src="../../components/number_choose/number_choose"></import>
<template>
	<div class="page" style="flex-direction: column">
		<div class="preview-item">
			<text static style="font-size: 24px;">
				此设置影响翻页时加载的文本量。
				值越大，每页加载的文本越多，但也可能增加单次加载时间。
				修改后需重进阅读页生效。
			</text>
		</div>
		<number style="position: absolute; bottom: 28px; left: 112px;" max.static="1200" min.static="400" step.static="100" unit.static="B" value="{{pageSize}}" @change="change" name.static="分段大小">
		</number>

		<img static src="/common/images/set.png" @click="back()" class="header-more"/>
		<text static class="header-title">
			分段大小
		</text>
	</div>
</template>

<script>
import router from "@system.router";
import storage from '../../utils/storage.js';

const STORAGE_KEY = "EBOOK_TXTSZPAGE";
const DEFAULT_SIZE = 400;

export default {
	private: {
		pageSize: DEFAULT_SIZE
	},
    
	onInit() {
		storage.get({
			key: STORAGE_KEY,
			success: (data) => {
				if (data) {
					this.pageSize = parseInt(data);
				}
			},
		});
	},
    
	change(e) {
		this.pageSize = e.detail.value;
		storage.set({
			key: STORAGE_KEY,
			value: this.pageSize.toString(),
		});
	},
    
	back() {
		storage.set({
			key: STORAGE_KEY,
			value: this.pageSize.toString(),
		});
		router.back();
	}
};
</script>

<style>
  @import '../../common/style.css';
</style>
