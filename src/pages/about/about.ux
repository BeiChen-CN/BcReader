</template>
  
<script>
  import router from '@system.router'
  import app from '@system.app' 
  
  export default {
    private: {
      appVer: '1.0.0',
      displayVersion: '1.0.0'
    },
    
    onInit() {
      this.appVer = app.getInfo().versionName;
      this.parseVersion();
    },
    
    back() {
      router.back();
    },
    
    parseVersion() {
      const version = this.appVer;
      const parts = version.split('.');
      let mainVersion = '';
      
      if (parts.length >= 3) {
        mainVersion = parts.slice(0, 3).join('.');
        
        if (parts.length <= 3 && (parts[2].includes('RW') || parts[2].includes('BAND'))) {
          mainVersion = mainVersion.replace('RW', '')
                                   .replace('BAND10', '')
                                   .replace('BAND', '');
        }
      } else {
        mainVersion = version;
      }
      
      this.displayVersion = mainVersion;
    }
  }
</script>
  
